# PostgreSQL connection string used by Prisma.
# Phase 1 runs fully without a database (client-side localStorage persistence).
# Provide this to enable server-side persistence via /app/api routes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virality?schema=public"

# Optional: enable a real AI video-analysis provider later.
# VIDEO_ANALYSIS_PROVIDER="mock"
# ANTHROPIC_API_KEY=""
